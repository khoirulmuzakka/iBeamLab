set(prefix "${BUILD_DIR}/consumer-prefix")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config "${CONFIG}" --prefix "${prefix}" RESULT_VARIABLE status OUTPUT_QUIET)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Install failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${SOURCE_DIR}/tests/consumer" -B "${BUILD_DIR}/consumer-build" "-DCMAKE_PREFIX_PATH=${prefix}" RESULT_VARIABLE status OUTPUT_QUIET)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Consumer configuration failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${BUILD_DIR}/consumer-build" --config "${CONFIG}" RESULT_VARIABLE status OUTPUT_QUIET)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Consumer build failed")
endif()
if(WIN32)
    set(exe "${BUILD_DIR}/consumer-build/${CONFIG}/consumer.exe")
    set(ENV{PATH} "${prefix}/bin;$ENV{PATH}")
else()
    set(exe "${BUILD_DIR}/consumer-build/consumer")
endif()
execute_process(COMMAND "${exe}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Consumer execution failed")
endif()
