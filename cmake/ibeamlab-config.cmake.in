@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT @BUILD_SHARED_LIBS@ AND @IBEAMLAB_HAS_OPENMP@)
    find_dependency(OpenMP COMPONENTS CXX)
endif()
if(NOT @BUILD_SHARED_LIBS@ AND @IBEAMLAB_HAS_ONNX@ AND NOT TARGET ONNXRuntime::ONNXRuntime)
    if(WIN32)
        add_library(ONNXRuntime::ONNXRuntime SHARED IMPORTED)
        set_target_properties(ONNXRuntime::ONNXRuntime PROPERTIES
            IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/onnxruntime.lib"
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/onnxruntime.dll")
    else()
        find_library(ibeamlab_ONNXRUNTIME_LIBRARY NAMES onnxruntime REQUIRED)
        add_library(ONNXRuntime::ONNXRuntime UNKNOWN IMPORTED)
        set_target_properties(ONNXRuntime::ONNXRuntime PROPERTIES
            IMPORTED_LOCATION "${ibeamlab_ONNXRUNTIME_LIBRARY}")
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ibeamlab-targets.cmake")
if(TARGET ibeamlab::ibeamlab AND NOT TARGET ibeamlab)
    add_library(ibeamlab INTERFACE IMPORTED)
    set_property(TARGET ibeamlab PROPERTY
        INTERFACE_LINK_LIBRARIES ibeamlab::ibeamlab)
endif()

set(_ibeamlab_runtime_files)
if(@BUILD_SHARED_LIBS@)
    list(APPEND _ibeamlab_runtime_files "$<TARGET_FILE:ibeamlab::ibeamlab>")
endif()
foreach(_name IN ITEMS @IBEAMLAB_RUNTIME_NAMES@)
    list(APPEND _ibeamlab_runtime_files "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/${_name}")
endforeach()
set_property(TARGET ibeamlab::ibeamlab PROPERTY IBEAMLAB_RUNTIME_FILES "${_ibeamlab_runtime_files}")
include("${CMAKE_CURRENT_LIST_DIR}/ibeamlab-runtime.cmake")

check_required_components(ibeamlab)
